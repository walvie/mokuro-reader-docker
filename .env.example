# Google Drive sync (optional — omit to disable)
VITE_GDRIVE_CLIENT_ID=
VITE_GDRIVE_API_KEY=

# OneDrive sync (optional — omit to hide the OneDrive option)
# Azure AD app registration with the deploy origin as an SPA redirect URI.
VITE_ONEDRIVE_CLIENT_ID=

# Self-hosted server library (Docker only, optional — see README.md
# "Self-hosted server library"). Absolute host path to a folder containing
# your mokuro-processed manga (any layout the normal import already
# understands — same-name folders, nested series, TOC-style chapters, etc.).
# Volumes found here are read directly by the reader over HTTP and are never
# copied into browser storage. Leave unset and the library is simply empty.
MANGA_LIBRARY_PATH=

# How often (in minutes) the library-server container re-scans
# MANGA_LIBRARY_PATH for changes. 0 (default) disables periodic re-scanning;
# trigger one on demand instead with `curl -X POST http://localhost:8080/api/rescan`
# (or after any change, just `docker compose restart library-server`).
LIBRARY_RESCAN_INTERVAL_MINUTES=0
